import "./core.zc"

// --- Hosted arena ---
// Used by the hosted allocator (malloc/calloc/free are disallowed in strict
// mode, which uses the typed pools below instead).

@cfg(not(misra))
struct StaticArena {
    data: byte*;
    capacity: usize;
    used: usize;
}

@cfg(not(misra))
impl StaticArena {
    fn init(self) {
        // 64KB static buffer for MISRA modes (block scope: Rule 8.9).
        static let buffer: [byte; 65536];
        self.data = &buffer[0];
        self.capacity = 65536;
        self.used = 0;
    }

    fn alloc_bytes(self, size: usize) -> void* {
        // Simple 8-byte alignment
        let base = self.data;
        let aligned = (self.used + 7) & ~(usize)7;
        if (aligned + size > self.capacity) {
            // In MISRA mode, we panic on exhaustion rather than returning NULL
            // to ensure deterministic failure.
            !"Panic: MISRA Static Arena exhausted!";
        }
        let ptr: void* = &base[aligned];
        self.used = aligned + size;
        return ptr;
    }

    fn alloc<T>(self) -> T* {
        let ptr: T* = (T*)self.alloc_bytes(sizeof(T));
        if (ptr != NULL) {
            memset(ptr, 0, sizeof(T));
        }
        return ptr;
    }

    fn alloc_n<T>(self, count: usize) -> T* {
        let size = count * sizeof(T);
        let ptr: T* = (T*)self.alloc_bytes(size);
        if (ptr != NULL) {
            memset(ptr, 0, size);
        }
        return ptr;
    }

    fn realloc<T>(self, old_ptr: T*, old_count: usize, new_count: usize) -> T* {
        let new_size = new_count * sizeof(T);
        let old_size = old_count * sizeof(T);

        // If it's the most recent allocation, we can just grow it in place!
        let base = self.data;
        let old_bytes: byte* = (byte*)old_ptr;
        let aligned_old = (self.used - old_size + 7) & ~(usize)7;
        if (&base[aligned_old] == old_bytes) {
            let new_aligned = (aligned_old + new_size + 7) & ~(usize)7;
            if (new_aligned <= self.capacity) {
                self.used = aligned_old + new_size;
                return old_ptr;
            }
        }

        // Otherwise, allocate new space and copy
        let new_ptr = (T*)self.alloc_bytes(new_size);
        if (old_ptr != NULL && old_size > 0) {
            memcpy(new_ptr, old_ptr, old_size);
        }
        return new_ptr;
    }
}

@cfg(not(misra))
fn _z_get_std_arena() -> StaticArena* {
    static let arena: StaticArena;
    static let initialized: bool = false;
    if (!initialized) {
        arena.init();
        initialized = true;
    }
    return &arena;
}

// --- Hosted internal helpers ---

@cfg(not(misra))
fn _z_internal_alloc_bytes(size: usize) -> void* {
    return calloc(1, size);
}

@cfg(not(misra))
fn _z_internal_zalloc_bytes(size: usize) -> void* {
    return calloc(1, size);
}

@cfg(not(misra))
fn _z_internal_realloc_bytes(ptr: void*, old_size: usize, new_size: usize) -> void* {
    let new_ptr = realloc(ptr, new_size);
    if (new_ptr != NULL && new_size > old_size) {
        memset((char*)new_ptr + old_size, 0, new_size - old_size);
    }
    return new_ptr;
}

@cfg(not(misra))
fn _z_internal_free(ptr: void*) {
    if (ptr != NULL) {
        free(ptr);
    }
}

@cfg(misra)
fn _z_pool_alloc<T>(ptr: T*, old_n: usize, new_n: usize) -> T* {
    static let data: T[4096];
    static let used: usize = 0;
    static let last: T* = NULL;

    let result = ptr;
    if (new_n > 0) {
        let in_place = false;
        if (ptr != NULL && old_n > 0 && used >= old_n) {
            let start: usize = used - old_n;
            if (ptr == last && start + new_n <= 4096) {
                if (new_n > old_n) {
                    let grow_at: usize = start + old_n;
                    memset(&data[grow_at], 0, (new_n - old_n) * sizeof(T));
                }
                used = start + new_n;
                in_place = true;
            }
        }

        if (!in_place) {
            if (used + new_n > 4096) {
                !"Panic: MISRA object pool exhausted";
            }
            let slot: usize = used;
            result = &data[slot];
            used = used + new_n;
            last = result;
            memset(result, 0, new_n * sizeof(T));
        }
    }
    return result;
}

@cfg(misra)
fn alloc_n<T>(n: usize) -> T* {
    return _z_pool_alloc<T>(NULL, 0, n);
}

@cfg(misra)
fn alloc<T>() -> T* {
    return alloc_n<T>(1);
}

@cfg(misra)
fn zalloc<T>() -> T* {
    return alloc_n<T>(1);
}

@cfg(misra)
fn realloc_n<T>(ptr: T*, old_n: usize, new_n: usize) -> T* {
    return _z_pool_alloc<T>(ptr, old_n, new_n);
}

@cfg(misra)
fn dealloc<T>(ptr: T*) {
    (void)ptr;
}


// --- Hosted public API ---
// The raw byte API is type-erased and therefore not available in strict mode;
// strict code uses alloc<T>() / alloc_n<T>() instead.

@cfg(not(misra))
fn alloc<T>() -> T* {
    return (T*)_z_internal_alloc_bytes(sizeof(T));
}

@cfg(not(misra))
fn zalloc<T>() -> T* {
    return (T*)_z_internal_zalloc_bytes(sizeof(T));
}

@cfg(not(misra))
fn alloc_n<T>(n: usize) -> T* {
    return (T*)_z_internal_alloc_bytes(n * sizeof(T));
}

@cfg(not(misra))
fn realloc_n<T>(ptr: T*, old_n: usize, new_n: usize) -> T* {
    return (T*)_z_internal_realloc_bytes((void*)ptr, old_n * sizeof(T), new_n * sizeof(T));
}

@cfg(not(misra))
fn dealloc<T>(ptr: T*) {
    _z_internal_free((void*)ptr);
}

@cfg(not(misra))
fn alloc_bytes(size: usize) -> void* {
    return _z_internal_alloc_bytes(size);
}

@cfg(not(misra))
fn zalloc_bytes(size: usize) -> void* {
    return _z_internal_zalloc_bytes(size);
}

// --- Box and Traits ---

trait Drop {
    fn drop(self);
}

trait Copy {}

trait Clone {
    fn clone(self) -> Self;
}

struct Box<T> {
    ptr: T*;
}

impl Box<T> {
    fn new() -> Self {
        return Self { ptr: alloc<T>() };
    }
    
    fn from_ptr(p: T*) -> Self {
        return Self { ptr: p };
    }
    
    fn get(self) -> T* {
        return self.ptr;
    }
    
    fn is_null(self) -> bool {
        return self.ptr == NULL;
    }
    
    fn free(self) {
        if self.ptr != NULL {
            dealloc<T>(self.ptr);
            self.ptr = NULL;
        }
    }
}

impl Drop for Box {
    fn drop(self) {
        self.free();
    }
}

// Note: Slice<T> is defined in std/slice.zc with iteration support

fn mem_zero<T>(ptr: T*, count: usize) {
    memset(ptr, 0, count * sizeof(T));
}

fn mem_copy<T>(dst: T*, src: T*, count: usize) {
    memcpy(dst, src, count * sizeof(T));
}

fn swap<T>(a: T*, b: T*) {
    let tmp = *a;
    *a = *b;
    *b = tmp;
}
