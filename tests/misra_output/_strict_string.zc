// Strict String subset: construction, length and free. The advanced/UTF-8,
// split/trim/replace and printing methods are hosted-only in the strict profile.
import "std/string.zc"

fn build() -> int {
    let s = String::new("hi");
    let n = (int)s.length();
    s.free();
    return n;
}

fn main() -> int {
    return (build() == 2) ? 0 : 1;
}
