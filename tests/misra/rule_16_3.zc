// MISRA Rule 16.3: An unconditional break or return shall terminate every switch-clause.
// Codegen terminates every lowered match case with a break, so the source does
// not need an explicit break/return.
// EXPECT: PASS

fn test_match_no_termination(x: int) -> int {
    let r = 0;
    match x {
        0 => {
            r = 0;
        }
        _ => {
            r = 1;
        }
    }
    return r;
}

fn test_match_safe(x: int) -> int {
    let r = 0;
    match x {
        0 => {
            r = 10;
        }
        _ => {
            r = 20;
        }
    }
    return r;
}

fn main() {
    let _a = test_match_no_termination(0);
    let _b = test_match_safe(1);
}
