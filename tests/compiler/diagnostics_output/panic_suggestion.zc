// ARGS: transpile
// zpanic_with_suggestion: overloaded operator with the wrong operand

@derive(Copy)
struct Vec2 {
    x: int;
    y: int;
}

impl Vec2 {
    fn add(self, other: Vec2) -> Vec2 {
        return Vec2 { x: self.x + other.x, y: self.y + other.y };
    }
}

fn main() {
    let a = Vec2 { x: 1, y: 2 };
    let b = a + 3;
}
